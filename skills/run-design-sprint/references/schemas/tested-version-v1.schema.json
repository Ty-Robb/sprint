{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ty-Robb/sprint/schemas/tested-version-v1.schema.json",
  "title": "Immutable tested prototype or MVP version 1.0",
  "type": "object",
  "required": [
    "schemaVersion",
    "recordType",
    "version",
    "artifactLevel",
    "prototypeArtifact",
    "prototypeContext",
    "approvedBrief",
    "buildPacket",
    "trialRun",
    "linkedArtifacts",
    "deployment",
    "claims",
    "frozenAt"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "recordType": {"const": "tested-prototype-version"},
    "version": {"$ref": "#/$defs/version"},
    "artifactLevel": {"enum": ["copy-concept", "concierge", "clickable", "coded-facade", "live-mvp", "limited-pilot"]},
    "prototypeArtifact": {"$ref": "#/$defs/sourceDescriptor"},
    "prototypeContext": {"$ref": "#/$defs/sourceDescriptor"},
    "approvedBrief": {
      "type": "object",
      "required": ["sha256", "snapshot"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "snapshot": {"$ref": "prototype-brief-v1.schema.json"}
      },
      "additionalProperties": false
    },
    "buildPacket": {"$ref": "#/$defs/sourceDescriptor"},
    "trialRun": {
      "type": "object",
      "required": ["id", "status", "moderator", "interviewScript", "testedArtifact", "findings", "issues", "ranAt"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "status": {"const": "passed"},
        "moderator": {"$ref": "#/$defs/nonEmptyString"},
        "interviewScript": {"$ref": "#/$defs/sourceDescriptor"},
        "testedArtifact": {"$ref": "#/$defs/sourceDescriptor"},
        "findings": {"$ref": "#/$defs/nonEmptyStringList"},
        "issues": {"$ref": "#/$defs/stringList"},
        "ranAt": {"$ref": "#/$defs/timestamp"}
      },
      "additionalProperties": false
    },
    "linkedArtifacts": {
      "type": "object",
      "required": ["experiment", "storyboard", "testPlan"],
      "properties": {
        "experiment": {"$ref": "#/$defs/sourceDescriptor"},
        "storyboard": {"$ref": "#/$defs/sourceDescriptor"},
        "testPlan": {"$ref": "#/$defs/sourceDescriptor"}
      },
      "additionalProperties": false
    },
    "deployment": {
      "type": "object",
      "required": ["target", "accessModel", "public", "url", "expiresAt", "cleanupPlan", "rollbackPlan", "recordedAt"],
      "properties": {
        "target": {"$ref": "#/$defs/nonEmptyString"},
        "accessModel": {"enum": ["private-local", "private-preview", "invite-only", "public"]},
        "public": {"type": "boolean"},
        "url": {"anyOf": [{"type": "null"}, {"type": "string", "format": "uri", "pattern": "^https?://"}]},
        "expiresAt": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/timestamp"}]},
        "cleanupPlan": {"$ref": "#/$defs/nonEmptyString"},
        "rollbackPlan": {"$ref": "#/$defs/nonEmptyString"},
        "recordedAt": {"$ref": "#/$defs/timestamp"}
      },
      "additionalProperties": false
    },
    "claims": {
      "type": "object",
      "required": ["customerValidated", "productionReady", "statement"],
      "properties": {
        "customerValidated": {"const": false},
        "productionReady": {"const": false},
        "statement": {"const": "A live URL and a passed trial do not establish customer validation or production readiness."}
      },
      "additionalProperties": false
    },
    "frozenAt": {"$ref": "#/$defs/timestamp"}
  },
  "additionalProperties": false,
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1},
    "stringList": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "nonEmptyStringList": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "identifier": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "version": {"$ref": "#/$defs/identifier"},
    "timestamp": {"type": "string", "format": "date-time"},
    "relativePath": {"type": "string", "minLength": 1, "pattern": "^[^/]"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "sourceDescriptor": {
      "type": "object",
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  }
}
