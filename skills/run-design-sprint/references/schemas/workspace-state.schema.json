{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ty-Robb/sprint/schemas/workspace-state.schema.json",
  "title": "Design Sprint workspace state",
  "type": "object",
  "required": [
    "schemaVersion",
    "title",
    "slug",
    "challenge",
    "route",
    "status",
    "currentStep",
    "completedSteps",
    "skippedSteps",
    "skipReasons",
    "pendingGate",
    "humanGates",
    "decisions",
    "artifacts",
    "customerTesting",
    "openQuestions",
    "nextAction",
    "createdAt",
    "updatedAt"
  ],
  "allOf": [
    {
      "if": {
        "properties": {"schemaVersion": {"const": "2.0"}},
        "required": ["schemaVersion"]
      },
      "then": {
        "required": [
          "methodProfile",
          "executionMode",
          "methodProfileSelection",
          "executionModeSelection",
          "fidelity",
          "routeHistory",
          "notApplicableSteps"
        ]
      }
    }
  ],
  "properties": {
    "schemaVersion": {"type": "string"},
    "title": {"type": "string", "minLength": 1},
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "challenge": {"type": "string", "minLength": 1},
    "methodProfile": {
      "enum": ["sprint-book", "adaptive-design-sprint"]
    },
    "executionMode": {
      "enum": ["live", "self-test", "planning-rehearsal"]
    },
    "methodProfileSelection": {"$ref": "#/$defs/selectionRecord"},
    "executionModeSelection": {"$ref": "#/$defs/selectionRecord"},
    "fidelity": {"$ref": "#/$defs/fidelity"},
    "route": {"$ref": "#/$defs/route"},
    "routeHistory": {
      "type": "array",
      "maxItems": 2,
      "items": {"$ref": "#/$defs/routeTransition"}
    },
    "routeRationale": {"type": "string"},
    "selectedConcept": {"type": "string", "minLength": 1},
    "selectedConceptRationale": {"type": "string"},
    "status": {"$ref": "#/$defs/workspaceStatus"},
    "currentStep": {"$ref": "#/$defs/stepId"},
    "completedSteps": {
      "type": "array",
      "items": {"$ref": "#/$defs/stepId"},
      "uniqueItems": true
    },
    "skippedSteps": {
      "type": "array",
      "items": {"$ref": "#/$defs/stepId"},
      "uniqueItems": true
    },
    "notApplicableSteps": {
      "type": "array",
      "items": {"$ref": "#/$defs/stepId"},
      "uniqueItems": true
    },
    "skipReasons": {
      "type": "object",
      "properties": {
        "01-intake": {"type": "string", "minLength": 1},
        "02-qualify": {"type": "string", "minLength": 1},
        "03-evidence": {"type": "string", "minLength": 1},
        "04-foundation": {"type": "string", "minLength": 1},
        "05-map": {"type": "string", "minLength": 1},
        "06-questions": {"type": "string", "minLength": 1},
        "07-explore": {"type": "string", "minLength": 1},
        "08-decide": {"type": "string", "minLength": 1},
        "09-experiment": {"type": "string", "minLength": 1},
        "10-prototype": {"type": "string", "minLength": 1},
        "11-customer-sessions": {"type": "string", "minLength": 1},
        "12-synthesis": {"type": "string", "minLength": 1},
        "13-outcome": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "pendingGate": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "#/$defs/gateId"}
      ]
    },
    "humanGates": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/humanGate"},
      "allOf": [
        {"contains": {"type": "object", "properties": {"id": {"const": "gate-1"}}, "required": ["id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "properties": {"id": {"const": "gate-2"}}, "required": ["id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "properties": {"id": {"const": "gate-3"}}, "required": ["id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "properties": {"id": {"const": "gate-4"}}, "required": ["id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "properties": {"id": {"const": "gate-5"}}, "required": ["id"]}, "minContains": 1, "maxContains": 1}
      ]
    },
    "decisions": {
      "type": "array",
      "items": {"$ref": "#/$defs/decision"}
    },
    "artifacts": {
      "type": "array",
      "items": {"$ref": "#/$defs/artifactRegistration"}
    },
    "customerTesting": {"$ref": "#/$defs/customerTesting"},
    "openQuestions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "resolvedQuestions": {
      "type": "array",
      "items": {"$ref": "#/$defs/resolvedQuestion"}
    },
    "nextAction": {"$ref": "#/$defs/nextAction"},
    "outcome": {
      "type": "string",
      "pattern": "^(?:[Pp][Rr][Oo][Cc][Ee][Ee][Dd]|[Ii][Tt][Ee][Rr][Aa][Tt][Ee]|[Pp][Ii][Vv][Oo][Tt]|[Ii][Nn][Vv][Ee][Ss][Tt][Ii][Gg][Aa][Tt][Ee]|[Ss][Tt][Oo][Pp])$"
    },
    "compatibility": {"$ref": "#/$defs/compatibility"},
    "createdAt": {"$ref": "#/$defs/timestamp"},
    "updatedAt": {"$ref": "#/$defs/timestamp"}
  },
  "additionalProperties": false,
  "$defs": {
    "timestamp": {"type": "string", "format": "date-time"},
    "route": {
      "enum": [
        "undecided",
        "research-first",
        "foundation-plus-design",
        "full-design-sprint",
        "focused-design-sprint",
        "no-sprint"
      ]
    },
    "workspaceStatus": {
      "enum": [
        "active",
        "waiting-for-human",
        "waiting-for-customers",
        "paused",
        "complete"
      ]
    },
    "stepId": {
      "enum": [
        "01-intake",
        "02-qualify",
        "03-evidence",
        "04-foundation",
        "05-map",
        "06-questions",
        "07-explore",
        "08-decide",
        "09-experiment",
        "10-prototype",
        "11-customer-sessions",
        "12-synthesis",
        "13-outcome"
      ]
    },
    "gateId": {"enum": ["gate-1", "gate-2", "gate-3", "gate-4", "gate-5"]},
    "artifactId": {
      "enum": [
        "01-sprint-brief",
        "02-evidence-ledger",
        "03-foundation",
        "04-journey-map",
        "05-sprint-questions",
        "06-solution-directions",
        "07-decision",
        "08-experiment",
        "09-storyboard",
        "10-test-plan",
        "11-customer-evidence",
        "12-synthesis",
        "13-outcome"
      ]
    },
    "artifactStatus": {
      "enum": ["draft", "in-review", "ready-for-decision", "complete", "blocked"]
    },
    "selectionRecord": {
      "type": "object",
      "required": ["selectedBy", "reason", "selectedAt"],
      "properties": {
        "selectedBy": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "selectedAt": {"$ref": "#/$defs/timestamp"}
      },
      "additionalProperties": false
    },
    "routeTransition": {
      "type": "object",
      "required": ["from", "to", "reason", "selectedAt"],
      "properties": {
        "from": {"$ref": "#/$defs/route"},
        "to": {"$ref": "#/$defs/route"},
        "reason": {"type": "string", "minLength": 1},
        "selectedAt": {"$ref": "#/$defs/timestamp"}
      },
      "additionalProperties": false
    },
    "fidelity": {
      "type": "object",
      "required": [
        "schemaVersion",
        "teamModel",
        "teamModelLimitation",
        "nonNegotiablePrinciples",
        "steps",
        "routeExclusions",
        "summary"
      ],
      "properties": {
        "schemaVersion": {"const": "1.0"},
        "teamModel": {"type": "string", "minLength": 1},
        "teamModelLimitation": {"type": "string", "minLength": 1},
        "nonNegotiablePrinciples": {
          "type": "array",
          "items": {"$ref": "#/$defs/fidelityPrinciple"},
          "uniqueItems": true
        },
        "steps": {"$ref": "#/$defs/fidelitySteps"},
        "routeExclusions": {
          "type": "array",
          "items": {"$ref": "#/$defs/routeExclusion"},
          "uniqueItems": true
        },
        "summary": {"$ref": "#/$defs/fidelitySummary"}
      },
      "additionalProperties": false
    },
    "fidelityPrinciple": {
      "type": "object",
      "required": ["id", "statement", "requirement"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1},
        "requirement": {"const": "non-negotiable"}
      },
      "additionalProperties": false
    },
    "fidelitySteps": {
      "type": "object",
      "required": [
        "01-intake",
        "02-qualify",
        "03-evidence",
        "04-foundation",
        "05-map",
        "06-questions",
        "07-explore",
        "08-decide",
        "09-experiment",
        "10-prototype",
        "11-customer-sessions",
        "12-synthesis",
        "13-outcome"
      ],
      "properties": {
        "01-intake": {"$ref": "#/$defs/fidelityStep"},
        "02-qualify": {"$ref": "#/$defs/fidelityStep"},
        "03-evidence": {"$ref": "#/$defs/fidelityStep"},
        "04-foundation": {"$ref": "#/$defs/fidelityStep"},
        "05-map": {"$ref": "#/$defs/fidelityStep"},
        "06-questions": {"$ref": "#/$defs/fidelityStep"},
        "07-explore": {"$ref": "#/$defs/fidelityStep"},
        "08-decide": {"$ref": "#/$defs/fidelityStep"},
        "09-experiment": {"$ref": "#/$defs/fidelityStep"},
        "10-prototype": {"$ref": "#/$defs/fidelityStep"},
        "11-customer-sessions": {"$ref": "#/$defs/fidelityStep"},
        "12-synthesis": {"$ref": "#/$defs/fidelityStep"},
        "13-outcome": {"$ref": "#/$defs/fidelityStep"}
      },
      "additionalProperties": false
    },
    "fidelityStep": {
      "type": "object",
      "required": [
        "canonicalPurpose",
        "defaultMethod",
        "selectedMethod",
        "participants",
        "timebox",
        "deviations"
      ],
      "properties": {
        "canonicalPurpose": {"type": "string", "minLength": 1},
        "defaultMethod": {"type": "string", "minLength": 1},
        "selectedMethod": {"type": "string", "minLength": 1},
        "participants": {"$ref": "#/$defs/fidelityParticipants"},
        "timebox": {"$ref": "#/$defs/fidelityTimebox"},
        "deviations": {
          "type": "array",
          "items": {"$ref": "#/$defs/fidelityDeviation"}
        }
      },
      "additionalProperties": false
    },
    "fidelityParticipants": {
      "type": "object",
      "required": ["human", "ai"],
      "properties": {
        "human": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "ai": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "fidelityTimebox": {
      "type": "object",
      "required": ["suggestedMinutes", "actualMinutes"],
      "properties": {
        "suggestedMinutes": {"type": "integer", "minimum": 0},
        "actualMinutes": {
          "anyOf": [
            {"type": "null"},
            {"type": "integer", "minimum": 0}
          ]
        }
      },
      "additionalProperties": false
    },
    "fidelityDeviation": {
      "type": "object",
      "required": [
        "type",
        "canonicalMethod",
        "selectedMethod",
        "preservedPurpose",
        "reason",
        "impact",
        "recordedAt"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"enum": ["substitution", "compression", "omission", "skip"]},
        "canonicalMethod": {"type": "string", "minLength": 1},
        "selectedMethod": {"type": "string", "minLength": 1},
        "preservedPurpose": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "impact": {"$ref": "#/$defs/fidelityImpact"},
        "recordedAt": {"$ref": "#/$defs/timestamp"}
      },
      "additionalProperties": false
    },
    "fidelityImpact": {
      "type": "object",
      "required": ["methodFidelity", "evidence", "decisionReadiness"],
      "properties": {
        "methodFidelity": {"type": "string", "minLength": 1},
        "evidence": {"type": "string", "minLength": 1},
        "decisionReadiness": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "routeExclusion": {
      "type": "object",
      "required": ["step", "reason"],
      "properties": {
        "step": {"$ref": "#/$defs/stepId"},
        "reason": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "fidelitySummary": {
      "type": "object",
      "required": ["assessment", "adaptations", "limitations"],
      "properties": {
        "assessment": {
          "enum": [
            "profile-followed",
            "adapted-with-documented-substitutions",
            "partial",
            "self-test-rehearsal",
            "not-applicable"
          ]
        },
        "adaptations": {
          "type": "array",
          "items": {"$ref": "#/$defs/fidelityAdaptation"}
        },
        "limitations": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "fidelityAdaptation": {
      "type": "object",
      "required": ["step", "type", "description"],
      "properties": {
        "step": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "compatibility": {
      "type": "object",
      "required": [
        "migratedFromSchemaVersion",
        "migrationNote",
        "migratedAt"
      ],
      "properties": {
        "migratedFromSchemaVersion": {"const": "1.0"},
        "migrationNote": {"type": "string", "minLength": 1},
        "migratedAt": {"$ref": "#/$defs/timestamp"}
      },
      "additionalProperties": false
    },
    "humanGate": {
      "type": "object",
      "required": ["id", "name", "status"],
      "properties": {
        "id": {"$ref": "#/$defs/gateId"},
        "name": {
          "enum": [
            "Challenge and sprint route",
            "Target and top risks",
            "Selected solution direction",
            "Prototype readiness",
            "Final outcome"
          ]
        },
        "status": {"enum": ["pending", "complete", "not-applicable"]},
        "decisionId": {"type": "string", "minLength": 1},
        "decision": {"type": "string", "minLength": 1},
        "deciderLabel": {"type": "string", "minLength": 1},
        "rationale": {"type": "string"},
        "decidedAt": {"$ref": "#/$defs/timestamp"}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "complete"}}, "required": ["status"]},
          "then": {
            "anyOf": [
              {"required": ["decisionId", "decision", "deciderLabel", "decidedAt"]},
              {"required": ["decision", "rationale", "decidedAt"]}
            ]
          }
        },
        {"if": {"properties": {"id": {"const": "gate-1"}}, "required": ["id"]}, "then": {"properties": {"name": {"const": "Challenge and sprint route"}}}},
        {"if": {"properties": {"id": {"const": "gate-2"}}, "required": ["id"]}, "then": {"properties": {"name": {"const": "Target and top risks"}}}},
        {"if": {"properties": {"id": {"const": "gate-3"}}, "required": ["id"]}, "then": {"properties": {"name": {"const": "Selected solution direction"}}}},
        {"if": {"properties": {"id": {"const": "gate-4"}}, "required": ["id"]}, "then": {"properties": {"name": {"const": "Prototype readiness"}}}},
        {"if": {"properties": {"id": {"const": "gate-5"}}, "required": ["id"]}, "then": {"properties": {"name": {"const": "Final outcome"}}}}
      ]
    },
    "decision": {
      "type": "object",
      "required": ["gate", "decision", "reservations", "decidedAt"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "gate": {"$ref": "#/$defs/gateId"},
        "decision": {"type": "string", "minLength": 1},
        "deciderLabel": {"type": "string", "minLength": 1},
        "consideredInputs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/consideredInput"},
          "uniqueItems": true
        },
        "subject": {"$ref": "#/$defs/decisionSubject"},
        "rationale": {"type": "string"},
        "reservations": {"type": "string"},
        "status": {"enum": ["active", "superseded"]},
        "supersededAt": {"$ref": "#/$defs/timestamp"},
        "supersededReason": {"type": "string", "minLength": 1},
        "decidedAt": {"$ref": "#/$defs/timestamp"}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "oneOf": [
            {"required": ["id", "deciderLabel", "consideredInputs", "subject", "status"]},
            {"required": ["rationale"], "not": {"required": ["id"]}}
          ]
        },
        {
          "if": {"properties": {"status": {"const": "superseded"}}, "required": ["status"]},
          "then": {"required": ["supersededAt", "supersededReason"]}
        }
      ]
    },
    "consideredInput": {
      "type": "object",
      "required": ["kind", "reference", "digest"],
      "properties": {
        "kind": {"enum": ["artifact", "assignment-result", "prototype", "route", "concept", "record"]},
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "decisionSubject": {
      "type": "object",
      "required": ["kind", "value", "digest"],
      "properties": {
        "kind": {"enum": ["route", "concept", "gate"]},
        "value": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "artifactRegistration": {
      "type": "object",
      "required": ["id", "title", "path", "status", "step", "updatedAt"],
      "properties": {
        "id": {"$ref": "#/$defs/artifactId"},
        "title": {"type": "string", "minLength": 1},
        "path": {"type": "string", "pattern": "^artifacts/[a-z0-9-]+\\.html$"},
        "status": {"$ref": "#/$defs/artifactStatus"},
        "step": {"$ref": "#/$defs/stepId"},
        "updatedAt": {"$ref": "#/$defs/timestamp"}
      },
      "additionalProperties": false
    },
    "customerTesting": {
      "type": "object",
      "required": ["status", "target", "sessionsPlanned", "sessionsCompleted"],
      "properties": {
        "status": {
          "enum": [
            "not-planned",
            "recruiting",
            "scheduled",
            "in-progress",
            "complete",
            "partial",
            "blocked"
          ]
        },
        "target": {"type": "string"},
        "targetRationale": {"type": "string"},
        "sessionsPlanned": {"type": "integer", "minimum": 0},
        "sessionsInvited": {"type": "integer", "minimum": 0},
        "sessionsAttempted": {"type": "integer", "minimum": 0},
        "sessionsCompleted": {"type": "integer", "minimum": 0},
        "sessionsQualified": {"type": "integer", "minimum": 0},
        "sessionsExcluded": {"type": "integer", "minimum": 0},
        "sessionsUsable": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "resolvedQuestion": {
      "type": "object",
      "required": ["question", "resolvedAt"],
      "properties": {
        "question": {"type": "string", "minLength": 1},
        "resolvedAt": {"$ref": "#/$defs/timestamp"}
      },
      "additionalProperties": false
    },
    "nextAction": {
      "type": "object",
      "required": ["title", "body", "humanInput"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "body": {"type": "string", "minLength": 1},
        "humanInput": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
