{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ty-Robb/sprint/schemas/artifact-data-v3.schema.json",
  "title": "Design Sprint artifact data 3.0",
  "allOf": [
    {"$ref": "artifact-data.schema.json"},
    {
      "type": "object",
      "properties": {"schemaVersion": {"const": "3.0"}},
      "required": ["schemaVersion", "materialFindings"]
    },
    {
      "if": {"type": "object", "properties": {"id": {"const": "13-outcome"}}, "required": ["id"]},
      "then": {"type": "object", "required": ["outcomeAssessment"]}
    }
  ]
}
