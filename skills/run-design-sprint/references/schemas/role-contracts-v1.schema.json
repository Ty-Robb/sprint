{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ty-Robb/sprint/schemas/role-contracts-v1.schema.json",
  "title": "Design Sprint role contracts 1.0",
  "type": "object",
  "required": ["schemaVersion", "roles"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "roles": {
      "type": "object",
      "required": [
        "sprint-orchestrator",
        "evidence-researcher",
        "product-strategist",
        "experience-designer",
        "technical-lead",
        "prototype-builder",
        "research-lead",
        "critical-reviewer",
        "synthesis-analyst"
      ],
      "properties": {
        "sprint-orchestrator": {"$ref": "#/$defs/roleContract"},
        "evidence-researcher": {"$ref": "#/$defs/roleContract"},
        "product-strategist": {"$ref": "#/$defs/roleContract"},
        "experience-designer": {"$ref": "#/$defs/roleContract"},
        "technical-lead": {"$ref": "#/$defs/roleContract"},
        "prototype-builder": {"$ref": "#/$defs/roleContract"},
        "research-lead": {"$ref": "#/$defs/roleContract"},
        "critical-reviewer": {"$ref": "#/$defs/roleContract"},
        "synthesis-analyst": {"$ref": "#/$defs/roleContract"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "roleContract": {
      "type": "object",
      "required": ["displayName", "mission", "may", "mustNot", "deliverable"],
      "properties": {
        "displayName": {"type": "string", "minLength": 1},
        "mission": {"type": "string", "minLength": 1},
        "may": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "mustNot": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "deliverable": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
