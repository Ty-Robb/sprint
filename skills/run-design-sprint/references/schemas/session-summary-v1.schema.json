{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ty-Robb/sprint/schemas/session-summary-v1.schema.json",
  "title": "Anonymized customer-session summary 1.0",
  "type": "object",
  "required": [
    "schemaVersion",
    "recordType",
    "sessionId",
    "participantId",
    "sessionDate",
    "prototypeVersion",
    "questionsVersion",
    "status",
    "anonymized",
    "containsDirectIdentifiers",
    "qualificationSummary",
    "sourceReferences",
    "observations",
    "inferences",
    "quoteReferences",
    "taskOutcomes",
    "questionEvidence",
    "surprises",
    "moderatorDeviations",
    "limitations",
    "uncertainties",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "recordType": {"const": "customer-session-summary"},
    "sessionId": {"$ref": "#/$defs/sessionIdentifier"},
    "participantId": {"$ref": "#/$defs/participantIdentifier"},
    "sessionDate": {"type": "string", "format": "date"},
    "prototypeVersion": {"$ref": "#/$defs/version"},
    "questionsVersion": {"$ref": "#/$defs/version"},
    "testedVersion": {"$ref": "#/$defs/sourceDescriptor"},
    "status": {"enum": ["draft", "complete"]},
    "anonymized": {"const": true},
    "containsDirectIdentifiers": {"const": false},
    "qualificationSummary": {"type": "string"},
    "sourceReferences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "reference", "redactionStatus"],
        "properties": {
          "id": {"$ref": "#/$defs/evidenceId"},
          "kind": {"enum": ["notes", "transcript", "audio", "video", "screen-capture", "other"]},
          "reference": {"type": "string", "minLength": 1},
          "redactionStatus": {"enum": ["not-reviewed", "in-progress", "complete", "not-required"]}
        },
        "additionalProperties": false
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "text", "sourceReferenceIds"],
        "properties": {
          "id": {"$ref": "#/$defs/evidenceId"},
          "label": {"const": "Observed"},
          "text": {"type": "string", "minLength": 1},
          "sourceReferenceIds": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidenceId"}, "uniqueItems": true}
        },
        "additionalProperties": false
      }
    },
    "inferences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "text", "observationIds"],
        "properties": {
          "id": {"$ref": "#/$defs/evidenceId"},
          "label": {"const": "Inference"},
          "text": {"type": "string", "minLength": 1},
          "observationIds": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidenceId"}, "uniqueItems": true}
        },
        "additionalProperties": false
      }
    },
    "quoteReferences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "sourceReferenceId", "locator"],
        "properties": {
          "id": {"$ref": "#/$defs/evidenceId"},
          "sourceReferenceId": {"$ref": "#/$defs/evidenceId"},
          "locator": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "taskOutcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["taskId", "outcome", "observationIds", "notes"],
        "properties": {
          "taskId": {"$ref": "#/$defs/evidenceId"},
          "outcome": {"enum": ["success", "partial", "failure", "not-attempted"]},
          "observationIds": {"type": "array", "items": {"$ref": "#/$defs/evidenceId"}, "uniqueItems": true},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "questionEvidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["questionId", "assessment", "observationIds", "notes"],
        "properties": {
          "questionId": {"$ref": "#/$defs/evidenceId"},
          "assessment": {"enum": ["for", "against", "mixed", "no-evidence"]},
          "observationIds": {"type": "array", "items": {"$ref": "#/$defs/evidenceId"}, "uniqueItems": true},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "surprises": {"$ref": "#/$defs/stringList"},
    "moderatorDeviations": {"$ref": "#/$defs/stringList"},
    "limitations": {"$ref": "#/$defs/stringList"},
    "uncertainties": {"$ref": "#/$defs/stringList"},
    "createdAt": {"$ref": "#/$defs/timestamp"},
    "updatedAt": {"$ref": "#/$defs/timestamp"}
  },
  "additionalProperties": false,
  "$defs": {
    "timestamp": {"type": "string", "format": "date-time"},
    "version": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "sessionIdentifier": {"type": "string", "minLength": 3, "maxLength": 32, "pattern": "^S[0-9][A-Z0-9-]*$"},
    "participantIdentifier": {"type": "string", "minLength": 3, "maxLength": 32, "pattern": "^P[0-9][A-Z0-9-]*$"},
    "evidenceId": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "relativePath": {"type": "string", "minLength": 1, "pattern": "^[^/]"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "sourceDescriptor": {
      "type": "object",
      "required": ["path", "sha256", "characters"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "characters": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "stringList": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
